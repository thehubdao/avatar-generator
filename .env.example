# ========================================
# AVATAR GENERATOR - ENVIRONMENT TEMPLATE
# ========================================
# Environment: Base Configuration Template
# Last updated: 19-06-2025
# Version: 1.0.0
# Maintainer: @gabch
# Project: Avatar Generator
# 
# Instructions:
# 1. Copy this file to .env.local if you need to override values
# 2. Replace 'your_*_here' with your actual values
# 3. This file IS committed to git (template)
# 4. Contains general environment values that apply to all environments
# ========================================

# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
# Set the environment type
# Development environment: NODE_ENV=development
# Production environment: NODE_ENV=production

NODE_ENV=development

# ========================================
# PINATA IPFS CONFIGURATION
# ========================================
# IPFS gateway and Pinata configuration for file storage

# ----- CLIENT SIDE -----
# IPFS gateway URL for accessing files
NEXT_PUBLIC_IPFS_GATEWAY=your_pinata_ipfs_gateway_url_here

# Pinata JWT token for authentication
# WARNING: This should be in .env.local with your actual JWT. In case it is not defined at .env or need to define a different value.
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_token_here

# IPFS gateway API key
# WARNING: This should be in .env.local with your actual API key. In case it is not defined at .env or need to define a different value.
NEXT_PUBLIC_IPFS_GATEWAY_API_KEY=your_ipfs_gateway_api_key_here

# ========================================
# VRM AND GLB PROCESSING CONFIGURATION
# ========================================
# Configuration for VRM and GLB file processing

# ----- CLIENT SIDE -----
# VRM processing service URL
NEXT_PUBLIC_VRM_PROCESS_SERVICE_URL=your_vrm_process_service_url_here

# Campaign identifier
NEXT_PUBLIC_CAMPAIGN=your_campaign_identifier_here

# ========================================
# NOTES
# ========================================
# - Variables with NEXT_PUBLIC_ prefix are exposed to the client
# - Variables without NEXT_PUBLIC_ are server-side only
# - Replace 'your_*_here' with actual values in .env.local if needed
# - This file contains base configuration shared across environments
# - Override specific values in .env.local or .env.local