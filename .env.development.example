# ========================================
# AVATAR GENERATOR - DEVELOPMENT TEMPLATE
# ========================================
# Environment: Development
# Last updated: 19-06-2025
# Version: 1.0.0
# Maintainer: @gabch
# Project: Avatar Generator
# 
# Instructions:
# 1. Copy this file to .env.development
# 2. Replace 'your_*_here' with your actual development values
# 3. This file IS committed to git (shared development config)
# 4. Contains development-specific values shared by the team
# ========================================

# ========================================
# LUKSO BLOCKCHAIN CONFIGURATION
# ========================================
# LUKSO blockchain configuration for development (testnet)

# ----- CLIENT SIDE -----
# RPC URL for LUKSO testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.lukso.network
# Universal page link for development
NEXT_PUBLIC_UNIVERSAL_PAGE_LINK=https://universalpage.dev
# Avatar contract address for development
NEXT_PUBLIC_AVATAR_CONTRACT_ADDRESS=your_development_avatar_contract_address_here
# Avatar proxy contract address for development
NEXT_PUBLIC_AVATAR_PROXY_ADDRESS=your_development_avatar_proxy_address_here
# Universal profile address for development
NEXT_PUBLIC_PROFILE_ADDRESS=your_development_profile_address_here

# ========================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ========================================
# Solana blockchain configuration for development (devnet)

# ----- CLIENT SIDE -----
# Solana RPC URL for development (devnet)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Candy machine ID for development
NEXT_PUBLIC_KUMI_CANDY_MACHINE_ID=your_development_candy_machine_id_here
# Collection ID for development
NEXT_PUBLIC_COLLECTION_ID=your_development_collection_id_here
# Guard collection ID for development
NEXT_PUBLIC_GUARD_COLLECTION_ID=your_development_guard_collection_id_here
# Candy machine treasury address for development
NEXT_PUBLIC_KUMI_CANDY_MACHINE_TREASURY=your_development_treasury_address_here

# ========================================
# ROOT BLOCKCHAIN CONFIGURATION
# ========================================
# Root blockchain configuration for development

# ----- CLIENT SIDE -----
# Root network WebSocket URL for development
NEXT_PUBLIC_ROOT_NETWORK_WS_URL=your_development_root_network_ws_url_here
# Root NFT collection ID for development
NEXT_PUBLIC_ROOT_NFT_COLLECTION_ID=your_development_root_nft_collection_id_here
# Root GraphQL API URL for development
NEXT_PUBLIC_ROOT_GQL_API_URL=your_development_root_gql_api_url_here
# Domain for development
NEXT_PUBLIC_DOMAIN=your_development_domain_here
# Origin URL for development
NEXT_PUBLIC_ORIGIN=your_development_origin_here
# Chain ID for development
NEXT_PUBLIC_CHAIN_ID=your_development_chain_id_here

# ========================================
# DEVELOPMENT NOTES
# ========================================
# - Use testnet URLs for LUKSO (rpc.testnet.lukso.network)
# - Use devnet URLs for Solana (api.devnet.solana.com)
# - Use development contract addresses
# - Use localhost for domain and origin
# - This file contains shared development configuration
# - Personal keys should go in .env.development.local. In case you need to define one of the variables here as locally private.
# - This file IS committed to git (shared config)