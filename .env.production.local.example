# ========================================
# AVATAR GENERATOR - PRODUCTION TEMPLATE
# ========================================
# Environment: Production
# Last updated: 08-08-2025
# Version: 1.1.0
# Maintainer: @gabch
# Project: Avatar Generator
# 
# Instructions:
# 1. Copy this file to .env.production.local
# 2. Replace 'your_*_here' with your actual production values
# 3. Never commit .env.production.local to git
# 4. Keep this file secure
# ========================================

# ========================================
# FIREBASE SERVICE CONFIGURATION
# ========================================
# Firebase configuration for production environment

# ----- CLIENT SIDE -----
# Firebase API key for client-side operations
NEXT_PUBLIC_FB_API_KEY=your_production_firebase_api_key_here
# Firebase authentication domain
NEXT_PUBLIC_FB_AUTH_DOMAIN=your_production_firebase_auth_domain_here
# Firebase project ID
NEXT_PUBLIC_FB_PROJECT_ID=your_production_firebase_project_id_here
# Firebase storage bucket
NEXT_PUBLIC_FB_STORAGE_BUCKET=your_production_firebase_storage_bucket_here
# Firebase messaging sender ID
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=your_production_firebase_messaging_sender_id_here
# Firebase app ID
NEXT_PUBLIC_FB_APP_ID=your_production_firebase_app_id_here
# WalletConnect project ID
NEXT_PUBLIC_WALLET_CONNECT_ID=your_production_wallet_connect_id_here
# Firebase password for server-side operations
# WARNING: This should be kept secure
NEXT_PUBLIC_FB_PASS=your_production_firebase_password_here
# Firebase user for server-side operations
# WARNING: This should be kept secure
NEXT_PUBLIC_FB_USER=your_production_firebase_user_here

# ----- SERVER SIDE -----
# Firebase password for server-side operations
AG_FB_PASS=your_production_firebase_password_here
# Firebase user for server-side operations
AG_FB_USER=your_production_firebase_user_here
# Admin user ID
NEXT_PUBLIC_ADMIN_ID=your_production_admin_id_here
# Firebase app ID (server-side)
FB_APP_ID=your_production_firebase_app_id_here
# Firebase API key (server-side)
FB_API_KEY=your_production_firebase_api_key_here
# Firebase auth domain (server-side)
FB_AUTH_DOMAIN=your_production_firebase_auth_domain_here
# Firebase project ID (server-side)
FB_PROJECT_ID=your_production_firebase_project_id_here

# ========================================
# PRIVY LOGIN SDK CONFIGURATION
# ========================================
# Privy authentication configuration for production

# ----- CLIENT SIDE -----
# Privy app ID for authentication
NEXT_PUBLIC_PRIVY_APP_ID=your_production_privy_app_id_here

# ========================================
# FUTUREVERSE LOGIN SDK CONFIGURATION
# ========================================
# Futureverse authentication configuration for production

# ----- CLIENT SIDE -----
# Futureverse client ID
NEXT_PUBLIC_CLIENT_ID=your_production_futureverse_client_id_here

# ========================================
# LUKSO BLOCKCHAIN CONFIGURATION
# ========================================
# LUKSO blockchain configuration for production

# ----- CLIENT SIDE -----
# Private key for LUKSO blockchain operations
# WARNING: This should be kept secure - use production key

# ----- SERVER SIDE -----
# JWT secret for authentication
# WARNING: This should be kept secure
AVATAR_ADMIN_PK=your_avatar_admin_private_key_here
WEARABLE_ADMIN_SIGNER_PK=your_wearable_admin_signer_private_key_here

# ========================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ========================================
# Solana blockchain configuration for production

# ----- CLIENT SIDE -----
# Solana RPC URL for production (use mainnet)
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=your_production_api_key_here"
# Admin wallet secret key for Solana operations
# WARNING: This should be kept secure - use production wallet
NEXT_PUBLIC_KUMI_ADMIN_WALLET_SECRET_KEY=your_production_solana_admin_wallet_secret_key_here

# ----- SERVER SIDE -----
# Admin wallet secret key for Solana operations (server-side)
# WARNING: This should be kept secure
KUMI_ADMIN_WALLET_SECRET_KEY=your_production_solana_admin_wallet_secret_key_here

# ========================================
# ROOT BLOCKCHAIN CONFIGURATION
# ========================================
# Root blockchain configuration for production

# ----- CLIENT SIDE -----
# Root signer private key
# WARNING: This should be kept secure - use production key
ROOT_SIGNER_PK=your_production_root_signer_private_key_here
# Signer private key for Root Network operations
# WARNING: This should be kept secure
NEXT_PUBLIC_SIGNER_PK=your_production_root_signer_private_key_here

# ========================================
# PRODUCTION NOTES
# ========================================
# - Use mainnet URLs for production
# - Use production wallets and keys
# - Never use test keys in production
# - Use development variables on production for not yet deployed features. If necessary
# - This file contains environment variables for development environment
# - Keep all production keys secure