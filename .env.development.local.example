# ========================================
# AVATAR GENERATOR - DEVELOPMENT TEMPLATE
# ========================================
# Environment: Development
# Last updated: 19-06-2025
# Version: 1.0.0
# Maintainer: @gabch
# Project: Avatar Generator
# 
# Instructions:
# 1. Copy this file to .env.development.local
# 2. Replace 'your_*_here' with your actual development values
# 3. Never commit .env.development.local to git
# 4. Keep this file secure
# ========================================

# ========================================
# FIREBASE SERVICE CONFIGURATION
# ========================================
# Firebase configuration for development environment

# ----- CLIENT SIDE -----
# Firebase API key for client-side operations
NEXT_PUBLIC_FB_API_KEY=your_firebase_api_key_here
# Firebase authentication domain
NEXT_PUBLIC_FB_AUTH_DOMAIN=your_firebase_auth_domain_here
# Firebase project ID
NEXT_PUBLIC_FB_PROJECT_ID=your_firebase_project_id_here
# Firebase storage bucket
NEXT_PUBLIC_FB_STORAGE_BUCKET=your_firebase_storage_bucket_here
# Firebase messaging sender ID
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
# Firebase app ID
NEXT_PUBLIC_FB_APP_ID=your_firebase_app_id_here
# WalletConnect project ID
NEXT_PUBLIC_WALLET_CONNECT_ID=your_wallet_connect_id_here
# Firebase password for server-side operations
# WARNING: This should be kept secure
NEXT_PUBLIC_FB_PASS=your_firebase_password_here
# Firebase user for server-side operations
# WARNING: This should be kept secure
NEXT_PUBLIC_FB_USER=your_firebase_user_here

# ----- SERVER SIDE -----
# Firebase password for server-side operations
AG_FB_PASS=your_firebase_password_here
# Firebase user for server-side operations
AG_FB_USER=your_firebase_user_here
# Admin user ID
NEXT_PUBLIC_ADMIN_ID=your_admin_id_here
# Firebase app ID (server-side)
FB_APP_ID=your_firebase_app_id_here
# Firebase API key (server-side)
FB_API_KEY=your_firebase_api_key_here
# Firebase auth domain (server-side)
FB_AUTH_DOMAIN=your_firebase_auth_domain_here
# Firebase project ID (server-side)
FB_PROJECT_ID=your_firebase_project_id_here

# ========================================
# PRIVY LOGIN SDK CONFIGURATION
# ========================================
# Privy authentication configuration

# ----- CLIENT SIDE -----
# Privy app ID for authentication
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# ========================================
# FUTUREVERSE LOGIN SDK CONFIGURATION
# ========================================
# Futureverse authentication configuration

# ----- CLIENT SIDE -----
# Futureverse client ID
NEXT_PUBLIC_CLIENT_ID=your_futureverse_client_id_here

# ========================================
# LUKSO BLOCKCHAIN CONFIGURATION
# ========================================
# LUKSO blockchain configuration for development

# ----- CLIENT SIDE -----
# Private key for LUKSO blockchain operations
# WARNING: This should be kept secure - use testnet key for development
NEXT_PUBLIC_PK=your_lukso_private_key_here

# ----- SERVER SIDE -----
# JWT secret for authentication
# WARNING: This should be kept secure
JWT_SECRET=your_jwt_secret_here

# ========================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ========================================
# Solana blockchain configuration for development

# ----- CLIENT SIDE -----
# Solana RPC URL for development (use devnet)
NEXT_PUBLIC_SOLANA_RPC_URL="https://devnet.helius-rpc.com/?api-key=your_devnet_api_key_here"
# Admin wallet secret key for Solana operations
# WARNING: This should be kept secure - use test wallet for development
NEXT_PUBLIC_KUMI_ADMIN_WALLET_SECRET_KEY=your_solana_admin_wallet_secret_key_here

# ----- SERVER SIDE -----
# Admin wallet secret key for Solana operations (server-side)
# WARNING: This should be kept secure
KUMI_ADMIN_WALLET_SECRET_KEY=your_solana_admin_wallet_secret_key_here

# ========================================
# ROOT BLOCKCHAIN CONFIGURATION
# ========================================
# Root blockchain configuration for development

# ----- CLIENT SIDE -----
# Root signer private key
# WARNING: This should be kept secure - use test key for development
ROOT_SIGNER_PK=your_root_signer_private_key_here
# Signer private key for Root Network operations
# WARNING: This should be kept secure
NEXT_PUBLIC_SIGNER_PK=your_root_signer_private_key_here

# ========================================
# DEVELOPMENT NOTES
# ========================================
# - Use testnet/devnet URLs for development
# - Use test wallets and keys for development
# - Never use production keys in development
# - This file contains environment variables for development environment